ROUTINE C0FZLACC [Type=MAC]
C0FZLACC ; temp - mirror VEHU lab accession areas onto FOIA inst 1 ; 2026-09-11
 ; Mirrors the vehu10 (VEHU demo DB) lab accessioning reference onto a FOIA
 ; instance under INSTITUTION ien 1 (PLATINUM). DATA = ien^name^accession-area
 ; dumped from vehu10 file #60 node 8 (inst 500) on 2026-09-11.
 ; Applied by scripts/iris-web-setup.sh step 1g: EN (60.11 rows), IDS (#68 .4
 ; numeric identifiers), FIX2 (LDL 901 SUBSCRIPT + #60.03 gap rows), ROLL
 ; (foreground ^LROLOVER; Taskman does not run on IRIS).
 Q
EN ; apply accession-area rows from DATA
 N CNT,ADD,SKA,SKN,HAV,ERRC,LN,REC,I60,NM,AA,FNM,I,J,GOT
 S (CNT,ADD,SKA,SKN,HAV,ERRC)=0
 F I=1:1 S LN=$T(DATA+I) Q:LN'[";;"  D
 . S REC=$P(LN,";;",2) Q:REC'["^"
 . S CNT=CNT+1
 . S I60=+$P(REC,"^"),NM=$P(REC,"^",2),AA=+$P(REC,"^",3)
 . I '$D(^LRO(68,AA,0)) S SKA=SKA+1 Q
 . S FNM=$P($G(^LAB(60,I60,0)),"^")
 . I FNM'=NM S I60=+$O(^LAB(60,"B",$E(NM,1,30),0)) I 'I60 S SKN=SKN+1 Q
 . S (J,GOT)=0 F  S J=$O(^LAB(60,I60,8,J)) Q:'J  I +$P($G(^LAB(60,I60,8,J,0)),"^")=1 S GOT=1
 . I GOT S HAV=HAV+1 Q
 . N FDA,IENA,DIERR
 . S FDA(60.11,"+1,"_I60_",",.01)=1
 . S FDA(60.11,"+1,"_I60_",",1)=AA
 . D UPDATE^DIE("",$NA(FDA),$NA(IENA))
 . I $D(DIERR) S ERRC=ERRC+1 W:ERRC<6 "ERR ",I60," ",NM,": ",$G(^TMP("DIERR",$J,1,"TEXT",1)),! K ^TMP("DIERR",$J) Q
 . S ADD=ADD+1
 W "rows=",CNT," added=",ADD," alreadyHad=",HAV," skipNoArea=",SKA," skipNoName=",SKN," fmErrs=",ERRC,!
 Q
IDS ; ensure each accession area has numeric identifier (field .4) a la SetAccessionIDs^SYNLINIT
 N I,C S I=0,C=0
 F  S I=$O(^LRO(68,I)) Q:'I  D
 . Q:$L($G(^LRO(68,I,.4)))
 . N FDA,DIERR
 . S FDA(68,I_",",.4)=I
 . D FILE^DIE("",$NA(FDA))
 . I $D(DIERR) W "IDS ERR area ",I,": ",$G(^TMP("DIERR",$J,1,"TEXT",1)),! K ^TMP("DIERR",$J) Q
 . S C=C+1
 W "numeric identifiers set: ",C,!
 Q
FIX2 ; LDL subscript + collection samples for known gaps
 N FDA,DIERR
 I $$GET1^DIQ(60,"901,",4,"I")'="CH" D
 . K FDA,DIERR S FDA(60,"901,",4)="CH" D FILE^DIE("",$NA(FDA))
 . I $D(DIERR) W "FIX2 sub ERR: ",$G(^TMP("DIERR",$J,1,"TEXT",1)),! K ^TMP("DIERR",$J) Q
 . W "LDL 901 subscript set to CH",!
 D CS1(901,20),CS1(15,20),CS1(16,20),CS1(416,20),CS1(53,49),CS1(280,49)
 Q
CS1(I60,I62) ; add collection sample row if none
 Q:$O(^LAB(60,I60,3,0))
 N FDA,IENA,DIERR
 S FDA(60.03,"+1,"_I60_",",.01)=I62
 D UPDATE^DIE("",$NA(FDA),$NA(IENA))
 I $D(DIERR) W "CS1 ERR ",I60,": ",$G(^TMP("DIERR",$J,1,"TEXT",1)),! K ^TMP("DIERR",$J) Q
 W "CS added test ",I60," sample ",I62,!
 Q
ROLL ; run lab rollover manually
 TRY {
 D ^LROLOVER
 } CATCH e {
 W "ROLLOVER CRASH: ",e.Name," ",e.Location,!
 }
 Q
RELAB(BIEN) ; re-run lab filing for one bundle
 N ROOT,F D ENVINIT^C0FHIR
 S ROOT=$$ROOT^C0FWGRT("fhir-intake")
 S F=0 F  S F=$O(@ROOT@(BIEN,"json","entry",F)) Q:'F  D ONE(ROOT,BIEN,F)
 D TALLY(BIEN)
 Q
ONE(ROOT,BIEN,F) ;
 N R
 TRY {
 D LOAD^C0FWLAB(ROOT,BIEN,F,.R)
 } CATCH e {
 W "CRASH entry ",F,": ",e.Name," ",e.Location,!
 }
 Q
TALLY(BIEN) ; summarize lab load statuses for bundle
 N ROOT,RI,ST,MSG,CNT,EMSG D ENVINIT^C0FHIR
 S ROOT=$$ROOT^C0FWGRT("fhir-intake")
 S RI=0 F  S RI=$O(@ROOT@(BIEN,"load","Lab",RI)) Q:'RI  D
 . S ST=$G(@ROOT@(BIEN,"load","Lab",RI,"loadStatus"))
 . S CNT(ST)=$G(CNT(ST))+1
 . I ST="error" S MSG=$E($G(@ROOT@(BIEN,"load","Lab",RI,"message")),1,90),EMSG(MSG)=$G(EMSG(MSG))+1
 S ST="" F  S ST=$O(CNT(ST)) Q:ST=""  W "bundle ",BIEN," ",ST,": ",CNT(ST),!
 S MSG="" F  S MSG=$O(EMSG(MSG)) Q:MSG=""  W "  ERR ",EMSG(MSG),"x ",MSG,!
 Q
